{
  "info": {
    "_postman_id": "8cc2b814-c1aa-4fa7-a1b2-noticeboard0001",
    "name": "NoticeBoard API",
    "description": "CRUD requests for the NoticeBoard weekend challenge. Configure baseUrl before running. No credentials are stored in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://YOUR_API_ID.execute-api.YOUR_REGION.amazonaws.com"
    },
    {
      "key": "noticeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "List notices",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/notices"
      }
    },
    {
      "name": "Get notice",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/notices/{{noticeId}}"
      }
    },
    {
      "name": "Create notice",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "if (body && body._id) pm.collectionVariables.set('noticeId', body._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"AWS Workshop Update\",\n  \"content\": \"Complete the Lambda exercise before the next session.\",\n  \"cohort\": \"Full-Stack AWS 28-Sep-2026\",\n  \"dueDate\": \"2026-10-05\"\n}"
        },
        "url": "{{baseUrl}}/notices"
      }
    },
    {
      "name": "Update notice",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated AWS Workshop Notice\"\n}"
        },
        "url": "{{baseUrl}}/notices/{{noticeId}}"
      }
    },
    {
      "name": "Delete notice",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/notices/{{noticeId}}"
      }
    }
  ]
}
